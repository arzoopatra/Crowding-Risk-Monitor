# Leave this unset for the demo: the app uses the bundled snapshot and makes no
# network calls, so nothing can fail on stage.
#
# Set it only to read from a running backend. The app will GET
# ${VITE_API_BASE}/api/snapshot and expects exactly the shape in src/types.ts.
# Copy this file to .env.local to activate.
#
# For the prototype API in server/ (`npm run api`), `npm run dev:api` sets this
# for one run and leaves no file behind:
#
# VITE_API_BASE=http://localhost:8787
