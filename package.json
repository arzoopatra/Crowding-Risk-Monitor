{
  "name": "crowding-risk-monitor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "mock": "node scripts/generate-mock.ts",
    "smoke": "node scripts/smoke.ts",
    "e2e": "node scripts/e2e.mjs",
    "api": "node server/index.ts",
    "api:fixture": "node scripts/generate-fixture.ts",
    "api:test": "node --test scripts/api.test.ts",
    "dev:api": "VITE_API_BASE=http://localhost:8787 vite",
    "verify": "tsc -b && node scripts/smoke.ts && node --test scripts/api.test.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
